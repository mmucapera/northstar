# Terraform state (and saved plan files) can contain secrets (e.g. the SPN
# client secret) in plaintext - never commit any of these.
*.tfstate
*.tfstate.*
.terraform/
crash.log
crash.*.log
*.tfplan
tfplan
plan.out
*.plan

# .terraform.lock.hcl is deliberately NOT ignored - it pins exact provider
# versions/checksums and should be committed for reproducible applies.

# Real variable values - copy terraform.tfvars.example instead.
*.tfvars
*.tfvars.json
!terraform.tfvars.example

override.tf
override.tf.json
*_override.tf
*_override.tf.json
